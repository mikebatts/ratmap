# Supabase — server-side ingest + API routes read from here.
# Mike wires up the real project; these are placeholders.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key is only used by the ingest scripts (never shipped to the browser).
SUPABASE_SERVICE_ROLE_KEY=

# Socrata (NYC Open Data) app token — optional, raises rate limits.
# Free to register at https://data.cityofnewyork.us/profile/app_tokens
SOCRATA_APP_TOKEN=

# MapTiler key for basemap tiles (optional — the app falls back to a free demo style).
NEXT_PUBLIC_MAPTILER_KEY=
