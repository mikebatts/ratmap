# Supabase — server-side ingest + API routes read from here.
# Mike wires up the real project; these are placeholders.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key is only used by the ingest scripts (never shipped to the browser).
SUPABASE_SERVICE_ROLE_KEY=

# Socrata (NYC Open Data) app token — optional, raises rate limits.
# Free to register at https://data.cityofnewyork.us/profile/app_tokens
SOCRATA_APP_TOKEN=

# MapTiler key for basemap tiles (optional — the app falls back to a free demo style).
NEXT_PUBLIC_MAPTILER_KEY=

# Canonical public site URL (no trailing slash). Drives metadataBase + OG image.
# Production: https://ratmap.nyc — swap here to change the domain in one place.
# Leave blank in dev to fall back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://ratmap.nyc

# Shared secret for the Vercel Cron daily-ingest endpoint. Generate a long
# random string (e.g. `openssl rand -hex 32`). Vercel sends it as a bearer token.
CRON_SECRET=
